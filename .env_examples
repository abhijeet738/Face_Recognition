# Every variable the stack reads, with safe dummy values (PLAN §6 + SPEC_AMENDMENTS).
# Copy to .env and run `make secrets` for real values. .env is git-ignored. Never commit it.

# ---------- general ----------
ENV=development            # development | test | production
DOMAIN=privface.example.com
LOG_LEVEL=INFO
GH_OWNER=your-github-username
TAG=latest
DEMO_MODE=false            # true = API may return the raw similarity score (SPEC_AMENDMENTS C1)

# ---------- postgres ----------
POSTGRES_USER=privface
POSTGRES_PASSWORD=change-me
POSTGRES_DB=privface
DATABASE_URL=postgresql+asyncpg://privface:change-me@postgres:5432/privface

# ---------- redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- api ----------
JWT_SECRET=change-me-48-random-bytes
JWT_TTL_SECONDS=900
IP_HASH_KEY=change-me          # HMAC key for ip_hash (SPEC_AMENDMENTS C5)
ML_URL=http://ml:8001
VAULT_URL=http://vault:8002
INTERNAL_TOKEN=change-me-48-random-bytes
VERIFY_THRESHOLD=0.0           # set from research results
IDENTIFY_THRESHOLD=0.0         # set from research results
LIVENESS_THRESHOLD=0.80
DEMO_USER_TTL_HOURS=24
LOCKOUT_MAX_FAILURES=5         # per username (SPEC_AMENDMENTS C4)
LOCKOUT_WINDOW_SECONDS=900
ADMIN_EMAIL=you@example.com
ADMIN_INITIAL_PASSWORD=change-me
ACME_EMAIL=you@example.com
CORS_ORIGINS=                  # empty in prod; http://localhost:5173 in dev

# ---------- vault (only the vault container receives these) ----------
IOM_MASTER_SECRET=base64-32-bytes
TEMPLATE_ENC_KEY=base64-32-bytes
APP_KEY_VERSION=1
IOM_M=256
IOM_Q=16
VAULT_MATRIX_CACHE=8           # SPEC_AMENDMENTS C8

# ---------- ml ----------
DET_SIZE=480                   # 320-480 (SPEC_AMENDMENTS C7)
MAX_FRAMES=8
MAX_FRAME_BYTES=1000000        # 1 MB per frame (SPEC_AMENDMENTS C9)
MAX_REQUEST_BYTES=8000000      # 8 MB per request, same limit in Caddy